rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can see who has the key; each user can only add or remove their own entry.
    match /keyHolders/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'openDate', 'openTime'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('openDate' in request.resource.data) || request.resource.data.openDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && (!('openTime' in request.resource.data) || request.resource.data.openTime.matches('^\\d{2}:\\d{2}$'));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /tables/{tableId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.gameName is string
        && request.resource.data.gameName.size() > 0
        && request.resource.data.gameName.size() <= 80
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.maxPlayers <= 20
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time;

      // Anyone can join or leave, only the host can change the rest.
      allow update: if (request.auth != null && request.auth.uid == resource.data.hostId)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
            && request.resource.data.players.size() <= resource.data.maxPlayers);

      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
    }
  }
}
